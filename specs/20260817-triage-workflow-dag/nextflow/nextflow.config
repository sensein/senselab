/*
 * Triage workflow — configuration.
 *
 * Two rules govern this file.
 *
 * 1. A value appears here only if a design document states it. Every other value is `null`, and the
 *    node that needs it either fails loudly or evaluates over the admissible interval. See
 *    `params.undecided` and `../benchmarks/open.md`.
 * 2. A model is named by `id` AND `revision`, and `revision` must be a 40-hex commit. A ref is
 *    refused by `validateParams()` in `main.nf`. Recording a ref while loading through it is worse
 *    than recording nothing, because the provenance is then confidently wrong.
 */

manifest {
    name            = 'senselab/triage'
    description     = 'Audio triage DAG over an append-only element store'
    author          = 'senselab'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {

    // ---------------------------------------------------------------- inputs
    input   = null                       // glob of recordings, e.g. 'data/*.wav'
    hints   = null                       // optional JSON: { "<recording-id>": { ... } }
    replay  = null                       // optional JSON of pre-computed measurements (see README)

    // Single-node entry points (`-entry RUN_AIRWAY` and friends) read the store from a directory
    // instead of from an upstream channel. Nothing else uses these.
    store_in    = null                   // dir holding segment.*.jsonl (and verdict.*.json for VERDICT)
    derivatives = null                   // dir holding PREPROCESS's heavy arrays

    // -------------------------------------------------------------- outputs
    //
    // TWO PUBLISH ROOTS, AND THEY ARE NEVER THE SAME DIRECTORY.
    //
    //   store_dir   — SENSITIVE. Segments, verdicts, views, figures. Carries element ids and,
    //                 after SPEECH, the unredacted transcript. Append-only, and therefore never
    //                 releasable (`redact.md`, `verdict.md`).
    //   release_dir — releasable derivatives from REDACT only. No element ids, no assertion ids,
    //                 no views, no verdicts. An id that indexes both is a join key back to the PII.
    //
    // `validateParams()` refuses a configuration in which one is inside the other.
    outdir      = 'results'
    store_dir   = "${params.outdir}/store"
    release_dir = "${params.outdir}/release"

    // -------------------------------------------------------------- devices
    device = 'cpu'                       // cpu | cuda | mps

    // --------------------------------------------------------------- models
    //
    // `id = null` where no design document names a model. The operator supplies it, with a
    // resolved commit. Nothing here guesses a repository name.
    models {
        yamnet         { id = 'google/yamnet';                                  revision = null }
        ast            { id = 'MIT/ast-finetuned-audioset-10-10-0.4593';        revision = null }
        hear           { id = null;                                             revision = null }
        crisperwhisper { id = 'nyralabs/CrisperWhisper2.0_turbo';               revision = null }
        asr_second     { id = null;                                             revision = null }
        alignment      { id = null;                                             revision = null }
        squim          { id = null;                                             revision = null }
        diarizer       { id = 'pyannote/speaker-diarization-community-1';       revision = null }
        diarizer_second{ id = null;                                             revision = null }
        separation     { id = 'alibabasglab/MossFormer2_SS_16K';                revision = null }
        pii            { id = null;                                             revision = null }
    }

    // ===================================================================================
    // DECIDED PARAMETERS — each traceable to a design document
    // ===================================================================================

    preprocess {
        sample_rate         = 16000      // preprocess.md "Working rate"
        preemphasis_enabled = true       // preprocess.md "Conditioning"
        preemphasis_a       = 0.97       // preprocess.md "Conditioning"
        envelope_lowpass_hz = 40         // preprocess.md `energy_envelope`
        envelope_unit       = 'dBFS'     // preprocess.md `energy_envelope`

        spans {
            k_db               = 18      // preprocess.md `spans`, AIRWAY's reading
            hangover_ms        = 120     // preprocess.md `spans`
            min_separation_ms  = 150     // preprocess.md `spans`
            onset_walkback_db  = 15      // preprocess.md `spans`
            offset_fraction    = 0.7     // preprocess.md `spans`
            min_duration_ms    = 50      // preprocess.md `spans`
            floor_percentile   = 10      // preprocess.md `spans`
            floor_window_s     = 3.0     // preprocess.md `spans`
        }

        silence { threshold = 0.5; window_s = 0.96; hop_s = 0.48 }   // preprocess.md `silence`

        spectrogram_wb { window_ms = 5;  hop_ms = 5 }                // preprocess.md
        spectrogram_nb { window_ms = 20; hop_ms = 5 }                // preprocess.md
        gammatone      { channels = 40; low_hz = 80; high_hz = 7800; hop_ms = 5 }
    }

    taxonomy {
        // taxonomy.md "Windows — each detector on its own default"
        windows {
            yamnet         { window_s = 0.96;  hop_s = 0.48 }
            hear           { window_s = 2.0;   hop_s = 0.25 }
            ast            { window_s = 10.24; hop_s = null }        // file-level
            crisperwhisper { window_s = null;  hop_s = null }        // no grid
        }
        // taxonomy.md "Independence — count families, not detectors"
        families {
            audioset        = ['yamnet', 'ast']
            lexical         = ['crisperwhisper']
            health_acoustic = ['hear']
        }
        // taxonomy.md "The screening set": HeAR reports Snore 0.88 / Speech 0.01 on verified speech.
        barred { hear = ['speech'] }
    }

    airway {
        labels_of_interest = ['Cough', 'Breathe']   // branch-airway.md step 1
        hear_threshold     = 0.5                    // branch-airway.md step 1
        hear_buffer_s      = 2.0                    // branch-airway.md step 1
        yamnet_threshold   = 0.5                    // branch-airway.md step 2
        // branch-airway.md step 2, the confirm mapping
        yamnet_label_map {
            Cough   = ['Cough']
            Breathe = ['Breathing', 'Sigh', 'Gasp']
        }
    }

    speech {
        yamnet_speech_threshold = 0.5      // branch-speech.md step 3
        diarizer_codomain       = [1, 2, 3]   // branch-speech.md step 4, 3 meaning ">=3"
        separation_n_sources    = 2        // branch-speech.md step 5, fixed by the checkpoint
        separate_when_count_ne  = 1        // branch-speech.md step 5
        // branch-speech.md step 8: reported, never gated.
        squim_gates = false
    }

    voice {
        // branch-voice.md step 2: runs are elementary; nothing is merged.
        merge_runs = false
    }

    redact {
        // REDACT is opt-in because its one required parameter has no measured value.
        // With `enabled = false` the node does not run and `verdict.md` gives release =
        // `not_assessed`, which is explicitly NOT `releasable`.
        enabled          = false
        scope            = 'every_finding'   // redact.md: not SPEECH's target-only scope
        verify           = true              // redact.md "Verification is part of the node"
        // Guard regex for the release directory. Any match is a node error, not a branch fail.
        id_pattern       = '[ea]-[0-9a-f]{16}'
    }

    // ===================================================================================
    // UNDECIDED PARAMETERS — `../benchmarks/open.md`
    //
    // `value = null` everywhere. A node handles a null in exactly one of two ways, and which one
    // is stated per entry:
    //
    //   INTERVAL-VALUED  the node evaluates the rule at every admissible value. Unanimous across
    //                    the range -> that outcome. Divergent -> `undecided` / `flag`, because the
    //                    measurement does not locate the boundary. No midpoint is invented.
    //   UNRUNNABLE       the node cannot proceed and says so. It does not substitute a default.
    // ===================================================================================
    undecided {

        // TAXONOMY `min_families` per kind. INTERVAL-VALUED.
        // taxonomy.md states the asymmetry (airway 3 eligible families, speech 2) and no value.
        // `admissible` excludes 1 for airway because one family is not "agreement".
        taxonomy_min_families {
            airway { admissible = [2, 3]; value = null; derivation = null }
            speech { admissible = [1, 2]; value = null; derivation = null }
        }

        // VOICE's phonation gate. INTERVAL-VALUED.
        // branch-voice.md step 2 / benchmarks/open.md: a factor of 2.1 and a factor of 23, on one
        // recording. The derivation slot stays empty until labelled verdicts exist.
        voice_gate {
            periodicity { interval = [0.44, 0.933];    value = null; derivation = null }
            rms         { interval = [0.0007, 0.0161]; value = null; derivation = null }
        }

        // SPEECH quality thresholds. Not needed: step 8 is reported, never gated, so the quality
        // `fail` is unreachable by design and no null has to be resolved.
        speech_squim_thresholds { stoi = null; pesq = null; si_sdr = null; derivation = null }

        // The word-gap threshold grouping words into speech spans.
        // Null means: do not invent a gap. Fall back to the recognizer's own utterance
        // segmentation, which is a measurement carrying provenance rather than our decision, and
        // record `span_grouping = "recognizer_native"`. UNRUNNABLE if the recognizer supplies no
        // utterance boundaries either.
        speech_word_gap_ms { value = null; fallback = 'recognizer_native'; derivation = null }

        // REDACT's outward padding margin. UNRUNNABLE.
        // It must exceed the WORST measured alignment edge error, which is unquantified. There is
        // no interval to evaluate over, so there is nothing honest to do but refuse.
        redact_padding_ms { value = null; must_exceed = 'worst_alignment_edge_error'; derivation = null }
    }

    // -------------------------------------------------- housekeeping
    publish_derivatives = false          // heavy arrays stay in the work directory
    validate_params     = true
}

// =======================================================================================
// Execution
// =======================================================================================

// A branch `fail` is a value in a verdict file, never an exit status. Every node exits 0 when it
// ran, whatever it concluded. A non-zero exit means the NODE broke, and that does abort.
process {
    errorStrategy = 'terminate'
    cache         = 'lenient'

    withLabel: triage_cpu   { cpus = 2;  memory = 4.GB  }
    withLabel: triage_dsp   { cpus = 4;  memory = 8.GB  }
    withLabel: triage_model { cpus = 4;  memory = 12.GB }
    withLabel: triage_asr   { cpus = 4;  memory = 16.GB }
}

profiles {

    standard { process.executor = 'local' }

    // Topology only: no model, no audio decoding. `nextflow run . -stub-run -profile stub`
    stub {
        params.validate_params = false
        params.redact.enabled  = true      // exercise SPEECH -> REDACT and the release guard
        process.executor       = 'local'
    }

    gpu {
        params.device = 'cuda'
        process {
            withLabel: triage_model { accelerator = 1 }
            withLabel: triage_asr   { accelerator = 1 }
        }
    }

    conda  { conda.enabled  = true }
    docker { docker.enabled = true; docker.runOptions = '-u $(id -u):$(id -g)' }

    // Deliberately tiny: enough to run the graph, not enough to claim a measurement.
    // `store_dir` / `release_dir` are restated because they were resolved from `outdir` when the
    // params block was read, and a profile assignment to `outdir` alone would not move them.
    test {
        params.input       = "${projectDir}/assets/test/*.wav"
        params.outdir      = 'results-test'
        params.store_dir   = 'results-test/store'
        params.release_dir = 'results-test/release'
    }
}

timeline { enabled = true; file = "${params.store_dir}/_pipeline_info/timeline.html" }
report   { enabled = true; file = "${params.store_dir}/_pipeline_info/report.html"   }
trace    { enabled = true; file = "${params.store_dir}/_pipeline_info/trace.txt"     }
dag      { enabled = true; file = "${params.store_dir}/_pipeline_info/dag.mmd"       }
