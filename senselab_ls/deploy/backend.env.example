# senselab diarization backend environment — copy to backend.env on the instance and fill in.
# Do NOT commit a filled-in copy (it holds secrets).

# Gated pyannote model access (huggingface.co token with the model licence accepted):
HF_TOKEN=

# Label Studio instance the backend downloads audio from / is registered with:
LABEL_STUDIO_URL=
LABEL_STUDIO_API_KEY=

# b2ai dataset root for the Audio+ metadata join (bucket name filled in per deployment):
B2AI_DATASET_ROOT=s3://<B2AI_DATASET_BUCKET>/data

# Diarization model + device:
DIA_MODEL=pyannote/speaker-diarization-community-1
DIA_DEVICE=cuda

# HF model cache on the persistent EBS volume:
HF_HOME=/opt/hf-cache

# So the `senselab_ls` package is importable by the backend process:
PYTHONPATH=/opt/senselab
