# senselab diarization backend — environment template.
#
# On the EC2 instance:
#     cd /opt/senselab/senselab_ls/deploy
#     cp backend.env.example backend.env
#     chmod 600 backend.env         # secrets — keep it private
#     nano backend.env              # fill in the values marked CHANGE below
#
# `backend.env` is gitignored; never commit a filled-in copy. Both the systemd unit
# (diarization.service, via EnvironmentFile=) and run_diarization_backend.sh read backend.env,
# so values persist across restarts/reboots — do NOT `export` them in a shell.

# ── CHANGE THESE ────────────────────────────────────────────────────────────
# HuggingFace token; the account must have accepted the model licence at
# huggingface.co/pyannote/speaker-diarization-community-1 ("Agree and access").
HF_TOKEN=

# HumanSignal Personal Access Token: user icon → Account & Settings → Personal Access Token.
# (A Legacy Token also works if your org still allows them, but they're often disabled — the
# PAT is the default.) The SDK auto-refreshes a PAT via /api/token/refresh, which REQUIRES
# LABEL_STUDIO_URL (below) to be set. A PAT expires per the org TTL, so it needs periodic
# rotation.
LABEL_STUDIO_API_KEY=

# b2ai dataset root on S3 — replace <B2AI_DATASET_BUCKET> with the real bucket name.
B2AI_DATASET_ROOT=s3://<B2AI_DATASET_BUCKET>/data

# ── USUALLY KEEP AS-IS ──────────────────────────────────────────────────────
# Label Studio instance: used to download LS-hosted audio AND required for the PAT token
# refresh (if unset, the SDK falls back to the machine hostname and predict fails with
# "connection refused").
LABEL_STUDIO_URL=https://app.humansignal.com

# Diarization model + device (set DIA_MODEL=nvidia/diar_sortformer_4spk-v1 for Sortformer).
DIA_MODEL=pyannote/speaker-diarization-community-1
DIA_DEVICE=cuda

# HF model cache on the persistent EBS volume (survives stop/start).
HF_HOME=/opt/hf-cache

# So the `senselab_ls` package is importable by the backend process.
PYTHONPATH=/opt/senselab
